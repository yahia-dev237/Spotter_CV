  {
    "exerciseId": "biceps_curl",
    "nameAr": "بايسيبس كيرل",
    "nameEn": "Biceps Curl",
    "requiredLandmarks": [
      11,
      12,
      13,
      14,
      15,
      16,
      23,
      24
    ],
    "repThresholds": {
      "primaryAngle": "elbow",
      "lowerDeg": 64,
      "upperDeg": 160,
      "facingCamera": {
        "topDeg": 180,
        "bottomDeg": 30,
        "note": "Equivalent elbow angle = 180 - acos(wrist drop / hanging drop); hanging drop stored in shoulder widths. STRAIGHTER of 2D and wrist-height angles is used."
      },
      "upperArmFromVerticalLimitDeg": 45,
      "upperArmBarCapPct": 90,
      "maxSpeedDegPerSec": 400,
      "maxSpeedWarnMultiplier": 1.3,
      "smoothing": "per-time 0.7 old + 0.3 new at 15 fps (pythonFps = 15)"
    },
    "rules": [
      {
        "id": "elbow_drift",
        "fault": "elbow_drift",
        "metric": "hipShoulderElbowAngleDeg",
        "comparator": "gt",
        "warnThreshold": 25,
        "rejectThreshold": 55,
        "threshold": 25,
        "severity": 3,
        "activeWhen": "always",
        "overrideKey": "elbowDrift / elbowDriftReject",
        "cueKey": "elbow_drift",
        "note": "Upper arm should stay near the torso. Side on, the far hip wobbles so it only REJECTS when far past the limit"
      },
      {
        "id": "body_swing",
        "fault": "body_swing",
        "metric": "leanChangeVsOwnStartDeg",
        "comparator": "gt",
        "warnThreshold": 12,
        "rejectThreshold": 32,
        "threshold": 12,
        "severity": 3,
        "activeWhen": "always",
        "overrideKey": "swing / swingReject",
        "cueKey": "body_swing",
        "note": "Compared with the user's own start posture (not a fixed number). Reject only when the body clearly moves"
      },
      {
        "id": "shoulder_shrug",
        "fault": "shoulder_shrug",
        "metric": "torsoLengthChangePct",
        "comparator": "gt",
        "warnThreshold": 12,
        "rejectThreshold": null,
        "threshold": 12,
        "severity": 1,
        "activeWhen": "always",
        "overrideKey": "shrug",
        "cueKey": "shoulder_shrug",
        "note": "Facing camera the label is 'Leaning - keep still'"
      },
