        "metric": "leftRightElbowAngleDiffDeg",
        "comparator": "gt",
        "warnThreshold": 25,
        "rejectThreshold": null,
        "threshold": 25,
        "severity": 1,
        "activeWhen": "facing_camera_depth_ge_40_not_front_deadlift",
        "cueKey": "asymmetry"
      }
