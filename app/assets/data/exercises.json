[
  {
    "exerciseId": "squat",
    "nameAr": "سكوات بالبار",
    "nameEn": "Barbell Back Squat",
    "requiredLandmarks": [
      11,
      12,
      23,
      24,
      25,
      26,
      27,
      28,
      31,
      32
    ],
    "repThresholds": {
      "primaryAngle": "knee",
      "lowerDeg": 95,
      "upperDeg": 165,
      "smoothing": "per-frame 0.7 old + 0.3 new",
      "depthClasses": {
        "partial": {
          "maxKneeAngleDeg": 130,
          "countsAsRep": true
        },
        "deep": {
          "maxKneeAngleDeg": 110
        },
        "extraDeep": {
          "maxKneeAngleDeg": 95
        }
      }
    },
    "rules": [
      {
        "id": "trunk_lean",
        "fault": "forward_lean",
        "metric": "trunkAngleFromVertical",
        "comparator": "gt",
        "warnThreshold": 60,
        "rejectThreshold": 70,
        "threshold": 60,
        "severity": 3,
        "activeWhen": "always",
        "adaptive": "limit += clamp((thigh/torso - 1) * 40, -10, +20); measured standing, frozen while depth < 15%",
        "cueKey": "forward_lean",
        "note": "Auto-adapts 50-80 based on user thigh/torso ratio"
      },
      {
        "id": "stance_narrow",
        "fault": "stance_narrow",
        "metric": "ankleToShoulderWidthRatio",
        "comparator": "lt",
        "warnThreshold": 0.6,
        "rejectThreshold": null,
        "threshold": 0.6,
        "severity": 1,
        "activeWhen": "facing_camera",
        "cueKey": "stance_narrow"
      },
      {
        "id": "stance_wide",
        "fault": "stance_wide",
        "metric": "ankleToShoulderWidthRatio",
        "comparator": "gt",
        "warnThreshold": 2.0,
        "rejectThreshold": null,
        "threshold": 2.0,
        "severity": 1,
        "activeWhen": "facing_camera",
        "cueKey": "stance_wide"
      },
      {
        "id": "knee_cave",
        "fault": "knee_valgus",
        "metric": "kneeCaveInwardShinLengths",
        "comparator": "gt",
        "warnThreshold": 0.15,
        "rejectThreshold": 0.25,
        "threshold": 0.15,
        "severity": 3,
        "activeWhen": "facing_camera_depth_ge_30",
        "usesToe": true,
        "cueKey": "knee_valgus",
        "note": "Worst knee counts; uses toe so deliberate toe-out stance is not punished"
      },
      {
        "id": "asymmetry",
        "fault": "asymmetry",
        "metric": "leftRightKneeAngleDiffDeg",
        "comparator": "gt",
        "warnThreshold": 25,
        "rejectThreshold": null,
        "threshold": 25,
        "severity": 1,
        "activeWhen": "facing_camera_depth_ge_40_not_front_deadlift",
        "cueKey": "asymmetry"
      }
    ],
    "cues": {
      "knee_valgus": {
        "ar": "ركبك داخلة لجوه، افتحها ناحية صوابع رجلك",
        "en": "Knees are caving in — push them out over your toes"
      },
      "depth": {
        "ar": "انزل أكتر شوية",
        "en": "Go a bit deeper"
      },
      "forward_lean": {
        "ar": "صدرك لقدّام أوي، ارفعه لفوق",
        "en": "Too much forward lean — chest up"
      },
      "lumbar_flexion": {
        "ar": "ضهرك بيتقوّس، خليه مفرود",
        "en": "Your lower back is rounding — keep it flat"
      },
      "asymmetry": {
        "ar": "وزّع الحمل على الجنبين بالتساوي",
        "en": "Even out the load between both sides"
      },
      "good_rep": {
        "ar": "تمام، كمّل",
        "en": "Good rep, keep going"
      },
      "stance_narrow": {
        "ar": "وقفك ضيق، وسّعه شوية",
        "en": "Stance too narrow — widen it a bit"
      },
      "stance_wide": {
        "ar": "وقفك واسع أوي، قرّبه شوية",
        "en": "Stance too wide — narrow it a bit"
      }
    }
  },
  {
    "exerciseId": "deadlift",
    "nameAr": "ديدليفت",
    "nameEn": "Conventional Deadlift",
    "requiredLandmarks": [
      7,
      8,
      11,
      12,
      15,
      16,
      23,
      24,
      25,
      26,
      27,
      28,
      31,
      32
    ],
    "repThresholds": {
      "primaryAngle": "hip",
      "lowerDeg": 100,
      "upperDeg": 165,
      "hipAngleVariants": {
        "conventional": {
          "topDeg": 165,
          "bottomDeg": 100
        },
        "sumo": {
          "topDeg": 158,
          "bottomDeg": 145
        },
        "romanian": {
          "topDeg": 158,
          "bottomDeg": 130
        }
      },
      "barPosition": {
        "landmarks": {
          "wrists": [
            15,
            16
          ],
          "knees": [
            25,
            26
          ],
          "ankles": [
            27,
            28
          ]
        },
        "topShinLengths": 0.81,
        "bottomShinLengths": 0,
        "source": "Winter 2009 (after Drillis & Contini) + Escamilla 2000 + Hanen 2025"
      },
      "bottomReachedBarPct": {
        "side": 90,
        "front": 85
      },
      "lockoutBarPct": 12,
      "squatInsteadOfDeadliftKneeAngleDeg": 100
    },
    "rules": [
      {
        "id": "spine_neutral",
        "fault": "spine_drift",
        "metric": "spineAngleDeviationFromOwnUprightDeg",
        "comparator": "gt",
        "warnThreshold": 25,
        "rejectThreshold": null,
        "threshold": 25,
        "severity": 1,
        "activeWhen": "side_view",
        "cueKey": "spine_drift",
        "note": "Cannot see lumbar spine; warn only. Facing camera: 'back not checked'"
      },
      {
        "id": "knee_bend_too_much_conventional",
        "fault": "knee_bend_excessive",
        "metric": "avgHipKneeAnkleAngleDeg",
        "comparator": "lt",
        "warnThreshold": 85,
        "rejectThreshold": null,
        "threshold": 85,
        "severity": 2,
        "activeWhen": "side_view_bar_ge_60",
        "cueKey": "knee_bend_excessive"
      },
      {
        "id": "knees_too_straight_conventional",
        "fault": "knees_too_straight",
        "metric": "avgHipKneeAnkleAngleDeg",
        "comparator": "gt",
        "warnThreshold": 150,
        "rejectThreshold": null,
        "threshold": 150,
        "severity": 2,
        "activeWhen": "side_view_bar_ge_60",
        "cueKey": "knees_too_straight"
      },
      {
        "id": "stance_width_conventional",
        "fault": "stance_width",
        "metric": "ankleToShoulderWidthRatio",
        "comparator": "range",
        "warnThresholdMin": 0.4,
        "warnThresholdMax": 1.6,
        "rejectThreshold": null,
        "threshold": 0.4,
        "severity": 1,
        "activeWhen": "facing_camera",
        "cueKey": "stance_width",
        "note": "Conventional stance is about hip width, narrower than shoulders, so 0.4 not 0.6"
      },
      {
        "id": "knee_cave",
        "fault": "knee_valgus",
        "metric": "kneeCaveInwardShinLengths",
        "comparator": "gt",
        "warnThreshold": 0.3,
        "rejectThreshold": null,
        "threshold": 0.3,
        "severity": 1,
        "activeWhen": "facing_camera_depth_ge_30",
        "cueKey": "knee_valgus",
        "note": "Knee cave is a squat fault. Looser limit and warn-only because toe-out feet fired on normal reps and painted the bar red"
      },
      {
        "id": "squat_instead_of_deadlift",
        "fault": "squat_instead_of_deadlift",
        "metric": "maxKneeAngleAtBottomDeg",
        "comparator": "lt",
        "warnThreshold": null,
        "rejectThreshold": 100,
        "threshold": 100,
        "severity": 3,
        "activeWhen": "side_view",
        "cueKey": "squat_instead_of_deadlift",
        "note": "Half squat starts at 110° (Schoenfeld 2010) - 10° pose error (Kim 2023) = 100. Conventional deadlift knees ~120° at lift-off (Hanen 2025)"
      }
    ],
    "cues": {
      "lumbar_flexion": {
        "ar": "ضهرك بيتقوّس، خليه مفرود",
        "en": "Your lower back is rounding — keep it flat"
      },
      "hips_rise_early": {
        "ar": "الحوض بيطلع قبل الصدر، ادفع الأرض برجلك الأول",
        "en": "Hips are rising too early — drive through your legs first"
      },
      "incomplete_lockout": {
        "ar": "قف مفرود تمامًا في الآخر",
        "en": "Stand tall and lock out at the top"
      },
      "asymmetry": {
        "ar": "وزّع الحمل على الجنبين بالتساوي",
        "en": "Even out the load between both sides"
      },
      "good_rep": {
        "ar": "تمام، كمّل",
        "en": "Good rep, keep going"
      },
      "spine_drift": {
        "ar": "ضهرك مش مفرود كويس من الجنب",
        "en": "Your back isn't neutral from the side view"
      },
      "knee_bend_excessive": {
        "ar": "ركبك منحنية أكتر من اللازم للديدليفت",
        "en": "Knees are bending too much for a deadlift"
      },
      "knees_too_straight": {
        "ar": "ركبك مفرودة أوي، اعمل hinge أكتر",
        "en": "Knees are too straight — hinge more"
      },
      "stance_width": {
        "ar": "عرض الوقفة مش مناسب",
        "en": "Stance width is off"
      },
      "knee_valgus": {
        "ar": "",
        "en": ""
      },
      "squat_instead_of_deadlift": {
        "ar": "ديديكت مش صحيح — شكله سكوات",
        "en": "That's a squat, not a deadlift"
      }
    }
  },
  {
